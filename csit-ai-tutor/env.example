# Copy this file to .env and fill in real values. Never commit the actual .env file.

# --- Auth ---
JWT_SECRET_KEY=replace_with_a_long_random_string

# --- Database (SQLite by default; switch to Postgres URL if you enable that service) ---
DATABASE_URL=postgresql://postgres:postgres123@db:5432/ai_tutor_db

# --- AI providers used by your tutor ---
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
